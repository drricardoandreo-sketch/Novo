# Supabase — Project Settings > API
# (equivalentes a SUPABASE_URL / SUPABASE_ANON_KEY, com o prefixo NEXT_PUBLIC_
# exigido pelo Next.js para uso no navegador)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Service role key — Project Settings > API (secreta, nunca expor no
# navegador). Usada pelas rotas de API server-side (/api/*) para operações
# autenticadas por x-api-key.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Chave usada pelas integrações externas (n8n) no header `x-api-key`.
# Gere um valor aleatório forte, ex: openssl rand -hex 32
EVOLVE_API_KEY=defina-uma-chave-segura-para-o-n8n

# Finanças pessoais — automação de WhatsApp (ver seção no README) --------
# Chave própria, separada da EVOLVE_API_KEY: dá acesso só ao endpoint de
# lançamento via WhatsApp, nunca aos dados do estúdio.
FINANCE_API_KEY=defina-outra-chave-segura-para-o-n8n
# UUID do usuário dono das finanças pessoais (Supabase > Authentication >
# Users > seu usuário > User UID).
FINANCE_OWNER_USER_ID=uuid-do-seu-usuario
